{
  "type": "object",
  "required": ["schema_version", "task", "status", "candidates", "warnings", "requires_human_review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "task": { "type": "string", "enum": ["subject_heading_suggestion"] },
    "status": { "type": "string", "enum": ["ok", "insufficient_evidence", "incomplete"] },
    "candidates": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["heading", "subdivisions", "confidence", "basis", "evidence", "authority_status"],
        "additionalProperties": false,
        "properties": {
          "heading": { "type": "string", "maxLength": 240 },
          "subdivisions": {
            "type": "array", "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["code", "value"],
              "additionalProperties": false,
              "properties": {
                "code": { "type": "string", "enum": ["x", "y", "z", "v"] },
                "value": { "type": "string", "maxLength": 240 }
              }
            }
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low", "insufficient_evidence"] },
          "basis": { "type": "string", "maxLength": 1200 },
          "evidence": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 400 } },
          "authority_status": { "type": "string", "enum": ["unverified", "verified"] }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 400 } },
    "requires_human_review": { "type": "boolean" }
  }
}
