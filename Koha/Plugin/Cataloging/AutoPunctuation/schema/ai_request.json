{
  "type": "object",
  "required": ["request_id", "task", "tag_context"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "maxLength": 64 },
    "task": {
      "type": "string",
      "enum": [
        "punctuation_explanation",
        "cataloging_classification",
        "subject_heading_suggestion",
        "cataloging_review",
        "training_tutor"
      ]
    },
    "context_mode": {
      "type": "string",
      "enum": ["tag_only", "tag_plus_related_fields", "full_record"]
    },
    "tag_context": {
      "type": "object",
      "required": ["tag", "occurrence", "subfields"],
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "maxLength": 3 },
        "ind1": { "type": "string", "maxLength": 1 },
        "ind2": { "type": "string", "maxLength": 1 },
        "occurrence": { "type": "number" },
        "active_subfield": { "type": "string", "maxLength": 1 },
        "subfields": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["code", "value"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "maxLength": 1 },
              "value": { "type": "string", "maxLength": 2000 },
              "punctuation_provenance": {
                "type": "object",
                "required": ["source", "value"],
                "additionalProperties": false,
                "properties": {
                  "source": { "type": "string", "maxLength": 32 },
                  "value": { "type": "string", "maxLength": 2000 },
                  "generated_prefix": { "type": "string", "maxLength": 8 },
                  "generated_suffix": { "type": "string", "maxLength": 8 }
                }
              }
            }
          }
        }
      }
    },
    "record_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["tag", "subfields"],
            "additionalProperties": false,
            "properties": {
              "tag": { "type": "string", "maxLength": 3 },
              "ind1": { "type": "string", "maxLength": 1 },
              "ind2": { "type": "string", "maxLength": 1 },
              "occurrence": { "type": "number" },
              "subfields": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": ["code", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "code": { "type": "string", "maxLength": 1 },
                    "value": { "type": "string", "maxLength": 2000 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "punctuation_explain": { "type": "boolean" },
        "subject_guidance": { "type": "boolean" },
        "call_number_guidance": { "type": "boolean" }
      }
    },
    "tutor_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["hint", "beginner", "rule", "why"]
        },
        "question": { "type": "string", "maxLength": 500 },
        "curriculum_context": { "type": "string", "maxLength": 1200 },
        "do_not_reveal_answer": { "type": "boolean" }
      }
    }
  }
}
